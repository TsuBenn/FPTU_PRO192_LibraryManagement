package services;

import java.time.LocalDate;
import java.time.temporal.ChronoUnit;
import java.util.List;
import java.util.stream.Collectors;
import models.Book;
import models.BorrowTransaction;
import repositories.BorrowTransactionRepository;

public class BorrowTransactionService {
    private final BorrowTransactionRepository txRepository;
    private static final double FINE_PER_DAY = 5000.0;

    public BorrowTransactionService(BorrowTransactionRepository txRepository) {
        this.txRepository = txRepository;
    }

    public List<BorrowTransaction> getAllTransactions() {
        return txRepository.findAll();
    }

    public List<BorrowTransaction> getActiveLoansByMember(String memberId) {
        return txRepository.findAll().stream()
                .filter(tx -> tx.getMemberId().equalsIgnoreCase(memberId) && tx.getReturnDate() == null)
                .collect(Collectors.toList());
    }

    public int countActiveLoans(String memberId) {
        return getActiveLoansByMember(memberId).size();
    }

    public boolean isBookBorrowedByMember(String memberId, String bookId) {
        return txRepository.findAll().stream()
                .anyMatch(tx -> tx.getMemberId().equalsIgnoreCase(memberId) &&
                        tx.getBookId().equalsIgnoreCase(bookId) &&
                        tx.getReturnDate() == null);
    }

    public void executeCheckout(BorrowTransaction tx, Book book) {
        txRepository.save(tx);
        book.setAvailableQuantity(book.getAvailableQuantity() - 1);
    }

    /**
     * Complete Business Logic Calculation wrapper for regular returning process.
     */
    public double processReturn(BorrowTransaction tx, Book book, LocalDate returnDate) {
        tx.setReturnDate(returnDate);
        if (book != null) {
            book.setAvailableQuantity(book.getAvailableQuantity() + 1);
        }
        long overdueDays = ChronoUnit.DAYS.between(tx.getDueDate(), returnDate);
        double charge = 0.0;
        if (overdueDays > 0) {
            charge = overdueDays * FINE_PER_DAY;
            tx.setFinePaid(charge);
        }
        return charge;
    }

    /**
     * Complete Business Logic Wrap for the lost book configuration event.
     * Returns an array containing [replacementCost, latePenaltyFine, totalInvoiceBill]
     */
    public double[] processLostBook(BorrowTransaction tx, Book book, double replacementCost) {
        tx.setReturnDate(LocalDate.now());

        long lateDays = ChronoUnit.DAYS.between(tx.getDueDate(), LocalDate.now());
        double penaltyFine = lateDays > 0 ? lateDays * FINE_PER_DAY : 0.0;
        double totalBill = replacementCost + penaltyFine;

        tx.setFinePaid(totalBill);

        if (book != null) {
            // Permanently shrink library total capability volume
            book.setTotalQuantity(book.getTotalQuantity() - 1);
        }

        return new double[]{replacementCost, penaltyFine, totalBill};
    }
}
